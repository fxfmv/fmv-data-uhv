{
  "base_url": "https://fmvtsenergyqual.net.fmv.ch:15230/api",
  "variables": {
    "cache_name": "TestAndrea",
    "storage_name": "1ere DIXENCE TestRest",
    "timeserie_key_to_import": "PFCTestRest",
    "timeserie_input": [
      {
        "timestamp": "2025-03-21T12:00:00Z",
        "value": 1
      },
      {
        "timestamp": "2025-03-21T12:15:00Z",
        "value": 2
      },
      {
        "timestamp": "2025-03-21T12:30:00Z",
        "value": 3
      },
      {
        "timestamp": "2025-03-21T12:45:00Z",
        "value": 6
      },
      {
        "timestamp": "2025-03-21T13:00:00Z",
        "value": 6
      },
      {
        "timestamp": "2025-03-21T13:15:00Z",
        "value": 6
      },
      {
        "timestamp": "2025-03-21T13:30:00Z",
        "value": 5
      },
      {
        "timestamp": "2025-03-21T13:45:00Z",
        "value": 3
      },
      {
        "timestamp": "2025-03-21T14:00:00Z",
        "value": 1
      }
    ]
  },
  "steps": [
    
    {
      "name": "Enregistrer le cache dans un snapshot",
      "method": "POST",
      "path": "/data/universes/$cache_name",
      "expect_status": 200,
      "save": {
        "universe_id": "universeId"
      }
    },
     {
      "name": "Récupérer les données d'entrée depuis le snapshot",
      "method": "GET",
      "path": "/data/universes/$universe_id/underlyings/$timeserie_key_to_import/timeseries/value",
      "expect_status": 200,
      "retry_statuses": [404],
      "retries": 10,
      "retry_delay_seconds": 2
    },
    {
      "name": "Récupérer les données de résultat depuis le snapshot",
      "method": "GET",
      "path": "/data/universe-results/$universe_id/storages/$storage_name/timeseries/volume",
      "expect_status": 200,
      "retry_statuses": [404],
      "retries": 10,
      "retry_delay_seconds": 2
    }
    
  ]
}
